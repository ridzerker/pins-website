{
  "name": "pins-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "prebuild": "node scripts/check-build-env.mjs && node scripts/copy-maplibre-worker.mjs",
    "postbuild": "node scripts/harden-csp.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/test-confirmation.mjs scripts/test-public-map.mjs",
    "test:website": "node scripts/test-website.mjs",
    "test:public-map": "node scripts/test-public-map-e2e.mjs",
    "test:basemap": "node scripts/test-basemap.mjs",
    "test:release": "node --test scripts/test-release-gate.mjs",
    "smoke": "node scripts/smoke-site.mjs",
    "verify": "node scripts/verify.mjs",
    "profile:public-map": "node scripts/profile-public-map.mjs",
    "test:marker-parity": "node --no-warnings --experimental-strip-types scripts/test-marker-parity.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.14.0",
    "next": "^16.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0"
  }
}
