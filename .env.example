# Public web maps (joinpins.app/@username). All three values are public by design and end up in
# browser JavaScript. Never put a Supabase service-role key or any other secret here.
# Without the Supabase pair, /@username pages show "This map isn't available right now".
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the Pins app's anon (public) key>
# Optional base map: "openfreemap" (no key) or "maptiler" (needs the key below). Empty contacts no
# map provider. docs/public-maps-basemap.md lists the other steps, including the security policy.
NEXT_PUBLIC_MAP_PROVIDER=
# A website-only MapTiler key restricted to joinpins.app origins. Without it the map shows pins
# on a plain background.
NEXT_PUBLIC_MAPTILER_KEY=
